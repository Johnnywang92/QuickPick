{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPick",
  "version": "0.1.0",
  "identifier": "com.quickpick.triage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickPick 极选 - 极速照片粗筛",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../LICENSES/*": "LICENSES/",
      "../docs/LIBRAW_REPLACEMENT.md": "docs/LIBRAW_REPLACEMENT.md"
    },
    "macOS": {
      "frameworks": [
        "Frameworks/libraw.25.dylib",
        "Frameworks/libomp.dylib",
        "Frameworks/libjpeg.8.dylib",
        "Frameworks/liblcms2.2.dylib"
      ]
    }
  }
}
