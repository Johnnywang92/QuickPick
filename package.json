{
  "name": "quickpick",
  "private": true,
  "version": "0.1.0",
  "author": "Johnny Boy Studio",
  "license": "Proprietary",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:ui": "vitest run",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
    "baseline": "node scripts/check_baselines.js",
    "accept:media": "cargo run --release --manifest-path src-tauri/Cargo.toml --features acceptance-bin --bin real-media-acceptance --",
    "verify:mac-bundle": "node scripts/check_macos_bundle.js",
    "bundle:mac": "bash scripts/bundle_macos_libs.sh && tauri build --bundles app && bash scripts/build_dmg.sh",
    "bundle:dmg": "bash scripts/build_dmg.sh",
    "gate": "npm run test:ui && npm run build && npm run clippy && npm run test:rs && npm run baseline",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
